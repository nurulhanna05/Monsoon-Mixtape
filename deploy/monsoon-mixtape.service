# systemd service for the app; setup.sh fills in the __PLACEHOLDERS__.
[Unit]
Description=Monsoon Mixtape
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PUBLIC_URL=__PUBLIC_URL__
ExecStart=__DIR__/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --proxy-headers --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
